# ==========================================
# SUPABASE CONFIGURATION
# Copia este archivo como .env y rellena con tus valores reales
# NUNCA subas el archivo .env al repositorio
# ==========================================
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# ==========================================
# GOOGLE AI STUDIO / GEMINI API
# Obtén tu clave en https://aistudio.google.com
# ==========================================
VITE_GEMINI_API_KEY=tu_gemini_api_key_aqui
VITE_GEMINI_API_KEY_BACKUP=tu_gemini_backup_key_aqui

# ==========================================
# PASARELA DE CORREO TRANSACCIONAL (RESEND)
# Obtén tu clave en https://resend.com
# ==========================================
RESEND_API_KEY=re_tu_clave_aqui
RESEND_FROM_EMAIL=JavrelStore <onboarding@resend.dev>
VITE_RESEND_API_KEY=re_tu_clave_aqui

# ==========================================
# PASARELAS DE PAGO (PAYPAL / WOMPI / CONVERSIÓN USD)
# ==========================================
VITE_PAYPAL_CLIENT_ID=tu_paypal_client_id_aqui
VITE_USD_EXCHANGE_RATE=4200
VITE_WOMPI_PUBLIC_KEY=tu_wompi_public_key_aqui

# PayPal — Entorno: sandbox | live
# VITE_PAYPAL_ENV se usa SOLO para detectar modo sandbox en el badge de UI.
VITE_PAYPAL_ENV=sandbox

# ==========================================
# PAYPAL — CREDENCIALES DE SERVIDOR (PRIVADAS)
# NUNCA usar prefijo VITE_ — estas JAMÁS se exponen al navegador
# Usadas exclusivamente por api/paypal-capture.js en Vercel
# ==========================================
PAYPAL_CLIENT_ID=tu_paypal_client_id_server_aqui
PAYPAL_CLIENT_SECRET=tu_paypal_client_secret_aqui
PAYPAL_ENV=sandbox
